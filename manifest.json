{
  "manifest_version": 3,
  "name": "Video to Slides - Lecture Slide Catcher",
  "short_name": "Video to Slides",
  "version": "3.1.0",
  "description": "Automatically capture HD slides from lecture videos with smart detection, timestamp jump, and instant PDF or HTML export.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "unlimitedStorage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Video to Slides (Click to Open)",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "lib/jspdf.umd.min.js",
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}